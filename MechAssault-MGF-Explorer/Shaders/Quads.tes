#version 400 core

layout( quads, equal_spacing, cw ) in;

out vec2 texCoord;

uniform mat4 modelView;
uniform mat3 modelViewNormal;
uniform mat4 projectionMatrix;
uniform mat4 mvp;

uniform sampler2D TerrainHeightMap;
uniform float TerrainMinHeight;
uniform float TerrainMaxHeight;

uniform float TerrainCellSize;
uniform float TerrainWorldScale;
uniform float TerrainFullSize;

void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    vec4 p00 = gl_in[0].gl_Position;
    vec4 p10 = gl_in[1].gl_Position;
    vec4 p11 = gl_in[2].gl_Position;
    vec4 p01 = gl_in[3].gl_Position;

    // Linearly interpolate to the vertex position using the
    // (u,v) barycentric coords
    vec4 pos = p00 * ( 1.0 - u ) * ( 1.0 - v )
             + p10 * u * ( 1.0 - v )
             + p01 * v * ( 1.0 - u )
             + p11 * u * v;

    texCoord = fract(vec2(pos.z, 1.0 - pos.x) / TerrainFullSize);

    // Set vertex height from height map
    pos.y += (textureLod(TerrainHeightMap, texCoord, 0).x) 
          * (TerrainMaxHeight - TerrainMinHeight) + TerrainMinHeight;

    gl_Position = mvp * pos;
}